# Required. Get a key at https://platform.claude.com (or run `ant auth login` instead).
ANTHROPIC_API_KEY=

# Provider: anthropic (default) or ollama (local, free, no key needed)
# JOBBOT_PROVIDER=ollama
# JOBBOT_MODEL=claude-opus-5          # or an Ollama model such as llama3.1, qwen3:8b, gemma3:12b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384                # context window requested from Ollama
# JOBBOT_DATA_DIR=./data
# JOBBOT_HEADLESS=false
